  <script>
    function tunjukAlert(mesej) {
       document.getElementById('customAlertText').innerText = mesej;
       document.getElementById('customAlertBox').style.display = 'flex';
    }
 
    function tutupAlert() {
       document.getElementById('customAlertBox').style.display = 'none';
    }

    function bukaTab(idTab, elemenButang) {
      var tabs = document.getElementsByClassName("tab-content");
      for (var i = 0; i < tabs.length; i++) {
       tabs[i].classList.remove("aktif");
      }
      var butang = document.getElementsByClassName("btn-menu");
      for (var i = 0; i < butang.length; i++) {
       butang[i].classList.remove("aktif");
      }
      document.getElementById(idTab).classList.add("aktif");
      elemenButang.classList.add("aktif");
    }
 
    function hantarSkala() {
      var pilihan = document.querySelector('input[name="skala"]:checked');
      if (pilihan) {
        var bintang = "⭐".repeat(pilihan.value);
        var tarikh = new Date().toLocaleDateString("ms-MY");
        var rekodBaru = document.createElement("p");
       rekodBaru.innerHTML = `<b>${tarikh}:</b> ${bintang} (${pilihan.value}/5)`;
       rekodBaru.style.borderBottom = "1px solid #ccc";
       rekodBaru.style.paddingBottom = "5px";
       document.getElementById("senarai-respon").prepend(rekodBaru);
       document.getElementById("live-feedback").style.display = "block";
       pilihan.checked = false;
      } else {
       tunjukAlert("Sila pilih skala 1 hingga 5 terlebih dahulu.");
      }
    }
 
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyi-V49qZXiNC2gzLGJi0LB9ImEFBgITZb1eAxg1HpTHQVIrxp1tp7NfEJ2BgAyN7VSTg/exec";
    
    let bookings = [];
    let currentDate = new Date();
    
    const monthNames = ["Januari", "Februari", "Mac", "April", "Mei", "Jun", "Julai", "Ogos", "September", "Oktober", "November", "Disember"];
 
    // Fungsi menukar bulan menggunakan butang Next / Prev (Sangat lancar di telefon)
    function ubahBulan(arah) {
        currentDate.setMonth(currentDate.getMonth() + arah);
        renderCalendar();
    }
 
    async function loadData() {
        document.getElementById('loading').style.display = "block";
        document.getElementById('loading').innerText = "Loading...";
        
        try {
            let res = await fetch(SCRIPT_URL, {
                method: 'GET',
                redirect: 'follow',
                headers: {
                    "Content-Type": "text/plain;charset=utf-8",
                }
            });
            
            if (!res.ok) {
                throw new Error("Ralat capaian server");
            }
            
            bookings = await res.json();
            document.getElementById('loading').style.display = "none";
            renderCalendar();
            
        } catch (e) {
            console.error(e);
            document.getElementById('loading').innerHTML = "<span style='color:red;'>Gagal memuat turun data. Sila semak internet anda dan refresh halaman.</span>";
        }
    }
 
    function renderCalendar() {
        const cal = document.getElementById("calendar");
        const dayNames = cal.querySelectorAll('.day-name');
        cal.innerHTML = '';
        dayNames.forEach(d => cal.appendChild(d));
 
        const year = currentDate.getFullYear();
        const month = currentDate.getMonth();
        
        // Kemaskini paparan teks bulan dan tahun di tengah
        document.getElementById("papar-bulan-tahun").innerText = `${monthNames[month]} ${year}`;
 
        const firstDay = new Date(year, month, 1).getDay();
        const totalDays = new Date(year, month + 1, 0).getDate();
 
        for (let i = 0; i < firstDay; i++) {
            let div = document.createElement("div");
            div.className = "day empty";
            cal.appendChild(div);
        }
 
        for (let d = 1; d <= totalDays; d++) {
            let div = document.createElement("div");
            div.className = "day";
           
            let dayNum = document.createElement("div");
            dayNum.className = "day-number";
            dayNum.innerText = d;
            div.appendChild(dayNum);
 
            let dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            
            let bookingsOnThisDay = getBookingForDate(dateStr);
            if (bookingsOnThisDay) {
                div.classList.add("booked");
               
                let infoContainer = document.createElement("div");
                infoContainer.style.width = "100%";
               
                bookingsOnThisDay.forEach(booking => {
                    let status = "";
                    let inDate = new Date(booking.masuk).toDateString();
                    let outDate = new Date(booking.keluar).toDateString();
                    let currentLoopDate = new Date(dateStr).toDateString();
 
                    if (currentLoopDate === inDate && currentLoopDate === outDate) {
                        status = "(In/Out)";
                    } else if (currentLoopDate === inDate) {
                        status = "(M)";
                    } else if (currentLoopDate === outDate) {
                        status = "(K)";
                    }
 
                    let pilihanInap = booking.pilihan || booking.jenis || booking.unit || booking.kategori || booking.penginapan || booking.homestay_roomstay || "Penginapan";
                   
                    let badgeColor = "#17a2b8"; 
                    let textUpper = pilihanInap.toUpperCase();
                    if (textUpper.includes("ROOMSTAY")) { badgeColor = "#28a745"; } 
                    else if (textUpper.includes("HOMESTAY")) { badgeColor = "#8e44ad"; } 
                    else if (textUpper.includes("KEDUA")) { badgeColor = "#e67e22"; } 
                   
                    let badgeHtml = `<div style="background:${badgeColor}; color:white; padding:2px 3px; border-radius:3px; display:inline-block; font-size:8px; font-weight:bold; margin:2px 0;">${pilihanInap}</div>`;
 
                    let infoText = document.createElement("div");
                    infoText.className = "guest-info";
                    infoText.innerHTML = `<strong>${booking.nama}</strong><br>${badgeHtml}<br><span style="font-size:8px; color:yellow;">${status}</span>`;
                    infoText.style.borderBottom = "1px dotted rgba(255,255,255,0.5)";
                    infoText.style.paddingBottom = "4px";
                    infoText.style.marginBottom = "4px";
                   
                    infoContainer.appendChild(infoText);
                });
               
                if (infoContainer.lastChild) {
                    infoContainer.lastChild.style.borderBottom = "none";
                    infoContainer.lastChild.style.marginBottom = "0";
                }
 
                div.appendChild(infoContainer);
            }
           
            cal.appendChild(div);
        }
    }
 
    function getBookingForDate(dateStr) {
        let results = [];
        let checkDate = new Date(dateStr);
        checkDate.setHours(0, 0, 0, 0);
 
        bookings.forEach(booking => {
            let inDate = new Date(booking.masuk);
            inDate.setHours(0, 0, 0, 0);
           
            let outDate = new Date(booking.keluar);
            outDate.setHours(0, 0, 0, 0);
 
            if (checkDate >= inDate && checkDate <= outDate) {
                results.push(booking);
            }
        });
 
        return results.length > 0 ? results : null;
    }
 
    function checkBookingPass() {
        var inputPass = document.getElementById("booking-pass-input").value;
        if (inputPass === "677397" || inputPass === "123456") {
            document.getElementById("booking-login-box").style.display = "none";
            document.getElementById("booking-admin-box").style.display = "block";
            document.getElementById("booking-error-msg").style.display = "none";
        } else {
            document.getElementById("booking-error-msg").style.display = "block";
        }
    }
 
    function handleEnterBooking(event) {
        if (event.key === "Enter") {
            checkBookingPass();
        }
    }
 
    function logoutBooking() {
        document.getElementById("booking-login-box").style.display = "block";
        document.getElementById("booking-admin-box").style.display = "none";
        document.getElementById("booking-pass-input").value = "";
    }
 
    function refreshData() {
        loadData();
        tunjukAlert("Data kalendar sedang dikemaskini. Ini mungkin mengambil sedikit masa.");
    }
 
    window.onload = function() {
        loadData();
    };
  </script>
